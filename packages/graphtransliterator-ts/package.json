{
	"name": "graphtransliterator-ts",
	"version": "0.2.0",
	"description": "A graph-based transliteratio tool",
	"homepage": "https://graphtransliterator.readthedocs.io/en/latest/typescript.html",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seanpue/graphtransliterator.git",
		"directory": "packages/graphtransliterator-ts"
	},
	"private": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --clean --dts",
		"watch": "tsup src/index.ts --format cjs,esm --watch",
		"test": "vitest run",
		"lint": "biome check src/ tests/",
		"lint:fix": "biome check --write src/ tests/"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/node": "^26.1.1",
		"tsup": "^8.5.1",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"yaml": "^2.9.0"
	}
}